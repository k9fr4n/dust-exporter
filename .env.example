# All optional. The proxy shares the dust-cli OAuth session by default
# (system keychain service "dust-cli", or ~/.dust-cli/credentials.json).

# HTTP server
DUST_PROXY_HOST=127.0.0.1
DUST_PROXY_PORT=8787
# If set, clients MUST send this as Bearer token / x-api-key on /v1/*.
DUST_PROXY_API_KEY=
# Fallback agent (sId or name) when the requested model matches nothing.
DUST_PROXY_DEFAULT_AGENT=
# Expose local filesystem tools to the Dust agent via reverse-MCP (experimental).
DUST_PROXY_WITH_TOOLS=0
# Bridge the CLIENT's own tools (Claude Code) into the Dust agent (passthrough).
DUST_PROXY_CLIENT_TOOLS=0
# Conversation lifecycle: 1 = ephemeral (create+replay+delete each turn, default,
# recommended for Claude Code / stateless clients); 0 = persistent (reuse via
# fingerprint, conversations are kept in Dust).
DUST_PROXY_EPHEMERAL=1
# Prefix prepended to every conversation title created by the proxy.
# Set to empty to let Dust auto-title instead.
DUST_PROXY_TITLE_PREFIX=PROXY: 
# The proxy identifies as the official dust-cli (User-Agent "Dust CLI" +
# this version header) so the Dust API accepts context.origin = "cli".
# Bump to match the installed dust-cli if the API ever rejects the version.
DUST_PROXY_CLI_VERSION=0.4.5

# Credential store backend: auto | keychain | file
DUST_CREDENTIAL_STORE=auto
# DUST_CREDENTIAL_FILE=/custom/path/credentials.json

# Dust / WorkOS endpoints (defaults target production).
DEFAULT_DUST_API_DOMAIN=https://dust.tt
DUST_US_URL=https://dust.tt
DUST_EU_URL=https://eu.dust.tt
WORKOS_DOMAIN=api.workos.com
WORKOS_CLIENT_ID=client_01JGCT55T7FVDG9XF74925R1KT
WORKOS_CLAIM_NAMESPACE=https://dust.tt/
